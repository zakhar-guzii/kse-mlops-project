# Copy to .env and replace the values. .env is ignored by Git.
# Use only letters, digits, hyphens and underscores. Airflow interpolates these values into its connection URIs.
POSTGRES_USER=landcover
POSTGRES_PASSWORD=change-me
# User and password of the local pgsty/silo store; DVC reads them under these standard S3 names.
AWS_ACCESS_KEY_ID=landcover
AWS_SECRET_ACCESS_KEY=change-me-too
